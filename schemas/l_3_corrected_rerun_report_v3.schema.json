{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "order_id", "hypothesis_id", "report_mode", "decision", "evidence_tier", "edge_claim", "provenance", "counts", "primary", "realized", "side_effects", "regimes", "validation_seal", "autopsy"],
  "properties": {
    "schema_version": {"const": "lily_l3_corrected_rerun_report_v3"}, "order_id": {"const": "B7.8"}, "hypothesis_id": {"const": "L-3"},
    "report_mode": {"enum": ["synthetic_not_run", "pre_return_failure", "future_execution"]}, "decision": {"enum": ["not_run", "scope_restricted", "falsified", "not_falsified_not_validated"]}, "evidence_tier": {"enum": ["E0", "E1"]}, "edge_claim": {"const": "none"},
    "provenance": {"$ref": "#/$defs/provenance"}, "counts": {"$ref": "#/$defs/counts"}, "primary": {"$ref": "#/$defs/primary"}, "realized": {"$ref": "#/$defs/realized"}, "side_effects": {"$ref": "#/$defs/side_effects"}, "regimes": {"$ref": "#/$defs/regimes"}, "validation_seal": {"$ref": "#/$defs/seal"}, "autopsy": {"anyOf": [{"$ref": "#/$defs/autopsy"}, {"type": "null"}]}
  },
  "allOf": [
    {"if": {"properties": {"report_mode": {"const": "synthetic_not_run"}}}, "then": {"properties": {"decision": {"const": "not_run"}, "evidence_tier": {"const": "E0"}, "autopsy": {"type": "null"}}}},
    {"if": {"properties": {"report_mode": {"const": "pre_return_failure"}}}, "then": {"properties": {"decision": {"const": "scope_restricted"}, "evidence_tier": {"const": "E1"}, "autopsy": {"type": "null"}}}},
    {"if": {"properties": {"report_mode": {"const": "future_execution"}}}, "then": {"properties": {"decision": {"enum": ["falsified", "not_falsified_not_validated"]}, "evidence_tier": {"const": "E1"}}}},
    {"if": {"properties": {"decision": {"const": "falsified"}}}, "then": {"properties": {"autopsy": {"$ref": "#/$defs/autopsy"}}}},
    {"if": {"properties": {"decision": {"enum": ["not_run", "scope_restricted", "not_falsified_not_validated"]}}}, "then": {"properties": {"autopsy": {"type": "null"}}}}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"}, "sha256": {"$ref": "#/$defs/sha"}}},
    "optional_identity": {"type": "object", "additionalProperties": false, "required": ["present", "path", "sha256"], "properties": {"present": {"type": "boolean"}, "path": {"type": ["string", "null"]}, "sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["producing_git_commit", "gate", "runner", "report_validator", "report_schema", "side_effect_library", "container_identity", "schedule_identity", "ledger_identity"], "properties": {"producing_git_commit": {"$ref": "#/$defs/commit"}, "gate": {"$ref": "#/$defs/identity"}, "runner": {"$ref": "#/$defs/identity"}, "report_validator": {"$ref": "#/$defs/identity"}, "report_schema": {"$ref": "#/$defs/identity"}, "side_effect_library": {"$ref": "#/$defs/identity"}, "container_identity": {"$ref": "#/$defs/optional_identity"}, "schedule_identity": {"$ref": "#/$defs/optional_identity"}, "ledger_identity": {"$ref": "#/$defs/optional_identity"}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["paired_observations", "effective_independent_bets", "mintrl_falsify", "asset_multiplier", "day_multiplier", "trade_multiplier", "t20_multiplier"], "properties": {"paired_observations": {"type": "integer", "minimum": 0, "maximum": 465}, "effective_independent_bets": {"type": "number", "minimum": 0}, "mintrl_falsify": {"const": 49}, "asset_multiplier": {"const": 1}, "day_multiplier": {"const": 1}, "trade_multiplier": {"const": 1}, "t20_multiplier": {"const": 1}}},
    "primary": {"type": "object", "additionalProperties": false, "required": ["ucb", "autocorrelation_ucb_trace"], "properties": {"ucb": {"type": ["number", "null"]}, "autocorrelation_ucb_trace": {"type": "array", "items": {"type": "number"}}}},
    "realized": {"type": "object", "additionalProperties": false, "required": ["evaluable", "complete_t_plus_20", "observations"], "properties": {"evaluable": {"type": "boolean"}, "complete_t_plus_20": {"type": "boolean"}, "observations": {"type": "integer", "minimum": 0}}},
    "side_effects": {"type": "object", "additionalProperties": false, "required": ["evaluable", "met", "cost_alias_turnover", "turnover_relative_increase", "cost_relative_increase", "cap_frequency_increase", "cash_frequency_increase", "scale_down_frequency_increase"], "properties": {"evaluable": {"type": "boolean"}, "met": {"type": "boolean"}, "cost_alias_turnover": {"const": false}, "turnover_relative_increase": {"type": ["number", "null"]}, "cost_relative_increase": {"type": ["number", "null"]}, "cap_frequency_increase": {"type": ["number", "null"]}, "cash_frequency_increase": {"type": ["number", "null"]}, "scale_down_frequency_increase": {"type": ["number", "null"]}}},
    "regime_claim": {"type": "object", "additionalProperties": false, "required": ["name", "evaluable", "funded", "observations"], "properties": {"name": {"type": "string", "minLength": 1}, "evaluable": {"type": "boolean"}, "funded": {"type": "boolean"}, "observations": {"type": "integer", "minimum": 0}}},
    "regimes": {"type": "object", "additionalProperties": false, "required": ["claims", "pooled"], "properties": {"claims": {"type": "array", "items": {"$ref": "#/$defs/regime_claim"}}, "pooled": {"const": false}}},
    "seal": {"type": "object", "additionalProperties": false, "required": ["status", "accessed"], "properties": {"status": {"const": "sealed_not_accessed"}, "accessed": {"const": false}}},
    "autopsy": {"type": "object", "additionalProperties": false, "required": ["volatility_scaling_concentration", "common_constraints", "ex_ante_vs_realized_hhi", "turnover_cost", "implementation_data_alternatives"], "properties": {"volatility_scaling_concentration": {"type": "string", "minLength": 1}, "common_constraints": {"type": "string", "minLength": 1}, "ex_ante_vs_realized_hhi": {"type": "string", "minLength": 1}, "turnover_cost": {"type": "string", "minLength": 1}, "implementation_data_alternatives": {"type": "string", "minLength": 1}}}
  }
}
