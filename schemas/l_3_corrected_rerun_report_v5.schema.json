    {"if":{"properties":{"report_mode":{"const":"pre_return_failure"}},"required":["report_mode"]},"then":{"properties":{"decision":{"const":"scope_restricted"},"evidence_tier":{"const":"E1"},"autopsy":{"type":"null"}}}},
    {"if":{"properties":{"report_mode":{"const":"future_execution"}},"required":["report_mode"]},"then":{"properties":{"decision":{"enum":["falsified","not_falsified_not_validated"]},"evidence_tier":{"const":"E1"}}}},
    {"if":{"properties":{"decision":{"const":"falsified"}},"required":["decision"]},"then":{"properties":{"autopsy":{"$ref":"#/$defs/autopsy"}}}},
    {"if":{"properties":{"decision":{"enum":["not_run","scope_restricted","not_falsified_not_validated"]}},"required":["decision"]},"then":{"properties":{"autopsy":{"type":"null"}}}}
