    "regime_claim":{"type":"object","additionalProperties":false,"required":["name","paired_observations","effective_independent_bets","mintrl_falsify","asset_multiplier","day_multiplier","trade_multiplier","t20_multiplier"],"properties":{"name":{"enum":["low","middle","high"]},"paired_observations":{"type":"integer","minimum":0,"maximum":465},"effective_independent_bets":{"type":"number","minimum":0},"mintrl_falsify":{"const":49},"asset_multiplier":{"const":1},"day_multiplier":{"const":1},"trade_multiplier":{"const":1},"t20_multiplier":{"const":1}}},
