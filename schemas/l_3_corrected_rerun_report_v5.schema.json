    "bound_identity":{"type":"object","additionalProperties":false,"required":["present","path","sha256"],"properties":{"present":{"type":"boolean"},"path":{"type":["string","null"]},"sha256":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["producing_git_commit","gate","runner","report_validator","report_schema","side_effect_library","container_identity","schedule_identity","ledger_identity"],"properties":{"producing_git_commit":{"$ref":"#/$defs/commit"},"gate":{"$ref":"#/$defs/identity"},"runner":{"$ref":"#/$defs/identity"},"report_validator":{"$ref":"#/$defs/identity"},"report_schema":{"$ref":"#/$defs/identity"},"side_effect_library":{"$ref":"#/$defs/identity"},"container_identity":{"$ref":"#/$defs/bound_identity"},"schedule_identity":{"$ref":"#/$defs/bound_identity"},"ledger_identity":{"$ref":"#/$defs/bound_identity"}}},
    "counts":{"type":"object","additionalProperties":false,"required":["paired_observations","effective_independent_bets","mintrl_falsify","asset_multiplier","day_multiplier","trade_multiplier","t20_multiplier"],"properties":{"paired_observations":{"type":"integer","minimum":0,"maximum":465},"effective_independent_bets":{"type":"number","minimum":0},"mintrl_falsify":{"const":49},"asset_multiplier":{"const":1},"day_multiplier":{"const":1},"trade_multiplier":{"const":1},"t20_multiplier":{"const":1}}},
    "primary":{"type":"object","additionalProperties":false,"required":["candidate_mean_hhi","comparator_mean_hhi","mean_delta","threshold","autocorrelation_ucb_trace","ucb"],"properties":{"candidate_mean_hhi":{"$ref":"#/$defs/number_or_null"},"comparator_mean_hhi":{"$ref":"#/$defs/number_or_null"},"mean_delta":{"$ref":"#/$defs/number_or_null"},"threshold":{"anyOf":[{"const":0.05},{"type":"null"}]},"autocorrelation_ucb_trace":{"type":"array","items":{"type":"number"}},"ucb":{"$ref":"#/$defs/number_or_null"}}},
    "realized":{"type":"object","additionalProperties":false,"required":["candidate_mean_hhi","comparator_mean_hhi","mean_delta","threshold","complete_t_plus_20_observations"],"properties":{"candidate_mean_hhi":{"$ref":"#/$defs/number_or_null"},"comparator_mean_hhi":{"$ref":"#/$defs/number_or_null"},"mean_delta":{"$ref":"#/$defs/number_or_null"},"threshold":{"anyOf":[{"const":0.05},{"type":"null"}]},"complete_t_plus_20_observations":{"type":"integer","minimum":0}}},
    "side_branch":{"type":"object","additionalProperties":false,"required":["turnover","commission","spread_slippage","sell_surcharge","cap_events","cash_events","scale_down_events"],"properties":{"turnover":{"type":"number","minimum":0},"commission":{"type":"number","minimum":0},"spread_slippage":{"type":"number","minimum":0},"sell_surcharge":{"type":"number","minimum":0},"cap_events":{"type":"integer","minimum":0},"cash_events":{"type":"integer","minimum":0},"scale_down_events":{"type":"integer","minimum":0}}},
